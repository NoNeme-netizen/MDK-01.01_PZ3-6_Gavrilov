<Window x:Class="PZ3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PZ3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Grid Grid.Row="0" Background="#FF76E3B3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Картинка из ресурсов -->
                <Image x:Name="imgLogo"
                   Grid.Column="0"
                   Width="45"
                   Height="45"
                   HorizontalAlignment="Left"
                   Margin="10,0,0,0"
                   Source="pack://application:,,,/Resources/logo.png"/>

                <!-- Кнопка Назад -->
                <Button x:Name="btnBack"
                    Grid.Column="2"
                    Content="← Назад"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Visibility="Hidden"
                    Click="btnBack_Click"/>
            </Grid>

            <!-- FRAME для страниц -->
            <Frame x:Name="FrmMain"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               ContentRendered="FrmMain_ContentRendered"/>
        </Grid>
    </Grid>
</Window>
