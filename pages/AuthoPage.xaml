<Page x:Class="PZ3.pages.AuthoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PZ3.pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthoPage">

    <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Авторизация"
                   Style="{StaticResource TitleTextBlock}"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Логин:" Style="{StaticResource AuthTextBlock}"/>
        <TextBox x:Name="txtLogin" Style="{StaticResource AuthTextBox}"/>

        <TextBlock Text="Пароль:" Style="{StaticResource AuthTextBlock}"/>
        <PasswordBox x:Name="txtPassword"
                     FontSize="14" Height="35" Width="250" Margin="0,5"
                     VerticalContentAlignment="Center" Padding="8,4"/>

        <!-- Капча: появляется после неудачной попытки входа -->
        <TextBlock x:Name="tblCaptcha"
                   Visibility="Collapsed"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
        <TextBox x:Name="txtCaptcha"
                 Style="{StaticResource AuthTextBox}"
                 Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnEnterGuests"
                    Content="Войти как гость"
                    Width="180" Height="45"
                    Click="btnEnterGuests_Click"/>
            <Button x:Name="btnLogin"
                    Content="Войти"
                    Width="110" Height="45"
                    Click="btnLogin_Click"/>
        </StackPanel>
    </StackPanel>
</Page>